    "var_05129b1c5155": {
      "type": "variant",
      "label": "03 · Hiring decision sheet",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--cream:#f7f4ed;--paper:#fcfbf8;--ink:#1c1c1c;--copy:#484844;--muted:#6f706b;--line:#e6e2d8;--soft:#eeebe3;--dark:#272821;--green:#526b4c;--rust:#9c573d;--blue:#586a7a;--gold:#a07731}\nbody{margin:0;background:var(--cream);color:var(--ink);font-family:'Manrope',sans-serif;font-size:15px;line-height:1.6}\nhtml{scroll-behavior:smooth}\nimg{display:block;max-width:100%}\na{color:inherit}\nbutton{font:inherit;color:inherit}\n.container{width:min(1240px,calc(100% - 88px));margin-inline:auto}\n.topbar{position:sticky;top:0;z-index:30;background:rgba(247,244,237,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(14px)}\n.nav-inner{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:28px}\n.wordmark{display:flex;align-items:center;gap:12px;text-decoration:none;white-space:nowrap}\n.monogram{width:36px;height:36px;border:1px solid var(--ink);display:grid;place-items:center;font-size:12px;font-weight:800;letter-spacing:-.06em}\n.brand-lines{line-height:1.2}.brand-name{font-size:13px;font-weight:800;letter-spacing:.04em}.brand-role{font-size:11px;color:var(--muted);margin-top:4px}\n.nav-links{display:flex;align-items:center;gap:28px}.nav-links a,.nav-action{text-decoration:none;font-size:13px;font-weight:600;color:var(--copy)}.nav-links a:hover,.footer a:hover{color:var(--rust);text-decoration:underline;text-underline-offset:4px}\n.nav-action{padding:9px 15px;border:1px solid var(--ink);background:var(--ink);color:var(--paper);border-radius:6px}.nav-action:hover,.button-dark:hover{background:var(--rust);border-color:var(--rust);color:white}\n.menu-toggle{display:none;width:42px;height:42px;border:1px solid var(--line);background:transparent;border-radius:6px;align-items:center;justify-content:center;font-size:19px}\n.hero{padding:46px 0 35px}.hero-top{display:flex;align-items:flex-end;justify-content:space-between;gap:48px;margin-bottom:32px}.hero-intro{max-width:720px}.hero h1{font-size:clamp(36px,5.7vw,68px);line-height:1.02;letter-spacing:-.075em;font-weight:600;margin:0 0 13px}.hero h1 span{font-weight:400;color:var(--green)}.hero-deck{max-width:600px;margin:0;color:var(--copy);font-size:16px;line-height:1.65}.hero-meta{display:flex;gap:11px 24px;flex-wrap:wrap;margin-top:18px;color:var(--copy);font-size:13px}.hero-meta strong{color:var(--ink);font-weight:700}.hero-meta span{display:inline-flex;align-items:center;gap:7px}.hero-actions{display:flex;gap:10px;flex-shrink:0;align-items:center}.button-dark,.button-link{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 16px;border-radius:6px;font-size:13px;font-weight:700;text-decoration:none;transition:background .2s,color .2s,border-color .2s}.button-dark{background:var(--ink);border:1px solid var(--ink);color:var(--paper)}.button-link{border:1px solid var(--line);color:var(--ink);background:var(--paper)}.button-link:hover{border-color:var(--ink);background:var(--soft)}\n.proof-heading{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px}.proof-heading h2,.section-heading h2{font-size:21px;line-height:1.2;letter-spacing:-.045em;font-weight:600;margin:0}.proof-heading a{font-size:13px;text-underline-offset:4px;font-weight:600}.proof-grid{display:grid;grid-template-columns:1.35fr .8fr .8fr;gap:15px;align-items:stretch}.proof{min-width:0;background:var(--paper);border:1px solid var(--line);border-radius:8px;overflow:hidden;display:flex;flex-direction:column}.proof-image{width:100%;height:230px;object-fit:cover;background:var(--soft)}.proof-main .proof-image{height:230px;object-fit:cover}.proof-body{padding:17px 19px 19px;display:flex;flex-direction:column;align-items:flex-start;flex:1}.proof-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:5px}.proof h3{font-size:18px;line-height:1.25;letter-spacing:-.04em;font-weight:700;margin:0 0 8px}.proof-copy{font-size:13px;color:var(--copy);line-height:1.55;margin:0 0 13px}.proof-foot{margin-top:auto;padding-top:6px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}.proof-link{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:700;text-decoration:underline;text-decoration-color:#b3aa99;text-underline-offset:4px}.proof-link:hover{text-decoration-color:var(--rust);color:var(--rust)}.proof-note{font-size:12px;color:var(--muted)}.proof-small .proof-image{height:158px}\n.content-section{padding:73px 0 0}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:26px}.section-heading p{max-width:490px;margin:0;color:var(--copy);font-size:14px}\n.career-list{border-top:1px solid var(--line)}.career-row{display:grid;grid-template-columns:minmax(170px,.72fr) minmax(260px,1.6fr) minmax(140px,.52fr);gap:28px;padding:24px 0;border-bottom:1px solid var(--line);align-items:start}.career-role{font-size:17px;line-height:1.3;font-weight:700;letter-spacing:-.035em}.career-company{font-size:14px;color:var(--copy);margin-top:4px}.career-dates{font-size:13px;color:var(--muted);text-align:right}.career-dates strong{display:block;color:var(--ink);font-weight:700}.career-bullets{margin:0;padding-left:18px;color:var(--copy);font-size:13px}.career-bullets li+li{margin-top:5px}.career-type{font-size:12px;font-weight:600;color:var(--green);margin-top:5px}\n.independent-intro{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:16px}.independent-intro h3{margin:0;font-size:18px;letter-spacing:-.035em}.independent-intro p{margin:0;font-size:13px;color:var(--muted)}.jam-lines{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:42px;border-top:1px solid var(--line)}.jam-line{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:14px 0;border-bottom:1px solid var(--line)}.jam-name{font-size:14px;font-weight:700}.jam-kind{font-size:12px;color:var(--muted);white-space:nowrap}\n.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}.evidence-column h3{font-size:17px;margin:0 0 15px;letter-spacing:-.035em}.award-feature{display:grid;grid-template-columns:190px minmax(0,1fr);gap:20px;align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:14px}.award-image{width:100%;height:132px;object-fit:contain;background:var(--soft);border-radius:4px}.award-kicker{font-size:12px;font-weight:700;color:var(--gold);margin-bottom:5px}.award-feature h4,.feedback-row h4{font-size:15px;line-height:1.35;margin:0 0 6px}.award-feature p,.feedback-row p{margin:0;color:var(--copy);font-size:13px;line-height:1.55}.feedback-list{border-top:1px solid var(--line)}.feedback-row{padding:15px 0;border-bottom:1px solid var(--line)}.feedback-client{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:5px}\n.project-section{padding-top:74px}.filter-bar{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.filter-title{font-size:13px;color:var(--copy);font-weight:600}.filters{display:flex;gap:6px;flex-wrap:wrap}.filter-btn{border:1px solid transparent;background:transparent;border-radius:999px;padding:8px 13px;font-size:12px;font-weight:700;color:var(--copy);cursor:pointer;min-height:38px}.filter-btn[aria-pressed=\"true\"]{background:var(--ink);color:var(--paper)}.filter-btn:hover:not([aria-pressed=\"true\"]){background:var(--soft)}.project-list{border-top:0}.project-row{display:grid;grid-template-columns:56px minmax(220px,1fr) minmax(130px,.72fr) minmax(125px,.55fr) 150px;gap:20px;align-items:center;padding:14px 6px;border-bottom:1px solid var(--line)}.project-row[hidden]{display:none}.project-thumb{width:56px;height:46px;object-fit:cover;border-radius:4px;background:var(--soft);border:1px solid var(--line)}.project-name{font-size:14px;font-weight:700;line-height:1.35}.project-context{font-size:12px;color:var(--muted);margin-top:3px}.project-engine,.project-type{font-size:12px;color:var(--copy)}.project-type{color:var(--muted)}.project-link{justify-self:end;font-size:12px;font-weight:700;text-underline-offset:3px}.project-link:hover{color:var(--rust)}\n.about-grid{display:grid;grid-template-columns:205px minmax(0,1.25fr) minmax(210px,.75fr);gap:35px;align-items:center}.portrait{width:205px;height:220px;object-fit:cover;border:1px solid var(--line);border-radius:8px;background:var(--soft)}.about-copy h2{font-size:22px;line-height:1.2;letter-spacing:-.04em;margin:0 0 12px}.about-copy p{font-size:14px;color:var(--copy);margin:0 0 11px}.skills-note{border-left:1px solid var(--line);padding:5px 0 5px 22px}.skills-note h3{font-size:14px;margin:0 0 8px}.skills-note p{font-size:13px;color:var(--copy);margin:0;line-height:1.8}\n.contact-band{margin-top:76px;background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:29px 32px;display:flex;justify-content:space-between;align-items:center;gap:25px}.contact-band h2{font-size:23px;margin:0 0 5px;letter-spacing:-.045em}.contact-band p{font-size:13px;color:var(--copy);margin:0}.contact-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}.footer{padding:25px 0 34px;margin-top:34px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:12px;color:var(--muted)}.footer-links{display:flex;gap:18px;flex-wrap:wrap}.footer a{text-underline-offset:3px}.social-link{display:inline-flex;align-items:center;gap:6px}.social-link img{width:15px;height:15px;object-fit:contain;filter:grayscale(1);opacity:.75}\n:focus-visible{outline:2px solid var(--green);outline-offset:3px}\n@media(max-width:900px){.container{width:min(100% - 48px,720px)}.nav-links{gap:17px}.nav-links a:nth-child(3){display:none}.hero-top{align-items:flex-start;flex-direction:column;gap:18px}.proof-grid{grid-template-columns:1.2fr .8fr}.proof-main{grid-row:span 2}.proof-main .proof-image{height:100%;min-height:390px}.proof-small .proof-image{height:140px}.career-row{grid-template-columns:155px 1fr;gap:20px}.career-dates{grid-column:1;text-align:left;grid-row:2}.career-bullets{grid-column:2;grid-row:1 / span 2}.project-row{grid-template-columns:48px minmax(180px,1fr) minmax(115px,.65fr) 130px}.project-thumb{width:48px;height:42px}.project-type{display:none}.about-grid{grid-template-columns:150px 1fr;gap:25px}.portrait{width:150px;height:175px}.skills-note{grid-column:2;border-left:0;border-top:1px solid var(--line);padding:15px 0 0}}\n@media(max-width:640px){.container{width:calc(100% - 36px)}.nav-inner{min-height:64px}.nav-links{display:none;position:absolute;top:64px;left:0;right:0;background:var(--cream);border-bottom:1px solid var(--line);padding:14px 18px 18px;flex-direction:column;align-items:stretch;gap:4px}.nav-links.open{display:flex}.nav-links a,.nav-links a:nth-child(3){display:block;padding:9px 2px}.nav-action{display:inline-flex;justify-content:center;margin-top:5px}.menu-toggle{display:flex}.hero{padding:32px 0 20px}.hero-top{margin-bottom:24px}.hero h1{font-size:clamp(36px,11vw,54px)}.hero-deck{font-size:14px}.hero-meta{display:grid;gap:8px}.hero-actions{width:100%}.hero-actions .button-dark{flex:1}.hero-actions .button-link{flex:0 0 auto}.proof-heading h2,.section-heading h2{font-size:19px}.proof-grid{display:flex;flex-direction:column;gap:12px}.proof-main .proof-image,.proof-image{height:auto;aspect-ratio:16/9;min-height:0}.proof-small{display:grid;grid-template-columns:112px 1fr;min-height:126px}.proof-small .proof-image{height:100%;min-height:126px;aspect-ratio:auto}.proof-body{padding:13px 14px}.proof-small .proof-body{padding:12px}.proof h3{font-size:15px}.proof-copy{font-size:12px;margin-bottom:8px}.proof-foot{padding-top:2px}.proof-note{display:none}.content-section{padding-top:52px}.section-heading{display:block}.section-heading p{margin-top:8px}.career-row{grid-template-columns:1fr auto;gap:9px 14px;padding:18px 0}.career-role{font-size:16px}.career-company{font-size:13px}.career-dates{grid-column:2;grid-row:1;text-align:right;font-size:12px}.career-bullets{grid-column:1 / -1;grid-row:2;padding-left:17px}.career-type{font-size:11px}.independent-intro{display:block}.independent-intro p{margin-top:5px}.jam-lines{grid-template-columns:1fr}.evidence-grid{grid-template-columns:1fr;gap:31px}.award-feature{grid-template-columns:105px 1fr;gap:13px;padding:10px}.award-image{height:105px}.award-feature p,.feedback-row p{font-size:12px}.project-section{padding-top:52px}.filter-bar{display:block}.filter-title{margin-bottom:9px}.filters{gap:4px}.filter-btn{padding:7px 10px;min-height:38px}.project-row{grid-template-columns:44px minmax(0,1fr) auto;gap:11px;padding:13px 0}.project-thumb{width:44px;height:42px}.project-engine,.project-type{display:none}.project-link{font-size:11px;max-width:100px;text-align:right}.about-grid{grid-template-columns:100px 1fr;gap:17px}.portrait{width:100px;height:128px}.about-copy h2{font-size:19px}.about-copy p{font-size:13px}.skills-note{grid-column:1 / -1;padding-top:12px}.contact-band{margin-top:52px;padding:21px 19px;display:block}.contact-band h2{font-size:20px}.contact-actions{margin-top:17px}.contact-actions .button-dark,.contact-actions .button-link{min-height:44px}.footer{display:block;font-size:11px}.footer-links{margin-top:12px;gap:14px}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}\n</style>\n<div class=\"min-h-screen bg-[var(--cream)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"sticky site header bar\">\n        <div class=\"container nav-inner\" data-kid=\"1-1-1\" data-name=\"header navigation container\">\n            <a aria-label=\"Eugene Flores, back to top\" class=\"wordmark\" data-kid=\"1-1-1-1\" data-name=\"brand wordmark link to top\" href=\"#top\">\n                <span class=\"monogram\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram badge\">\n                    EF\n                </span>\n                <span class=\"brand-lines\" data-kid=\"1-1-1-1-2\" data-name=\"brand name and role stack\">\n                    <span class=\"brand-name block\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        EUGENE FLORES II\n                    </span>\n                    <span class=\"brand-role block\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand role text\">\n                        Gameplay programmer · Unity + Godot\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"nav-links\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\" id=\"site-nav\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"navigation link to projects\" href=\"#projects\">\n                    Projects\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"navigation link to experience\" href=\"#experience\">\n                    Experience\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"navigation link to recognition\" href=\"#recognition\">\n                    Recognition\n                </a>\n                <a data-kid=\"1-1-1-2-4\" data-name=\"navigation link to about\" href=\"#about\">\n                    About\n                </a>\n                <a class=\"nav-action\" data-kid=\"1-1-1-2-5\" data-name=\"download résumé navigation button\" download=\"\" href=\"docs/Flores_Resume.pdf\">\n                    <i aria-hidden=\"true\" class=\"icon-download\" data-kid=\"1-1-1-2-5-1\" data-name=\"download icon\">\n                    </i>\n                    Download résumé\n                </a>\n            </nav>\n            <button aria-controls=\"site-nav\" aria-expanded=\"false\" aria-label=\"Open navigation\" class=\"menu-toggle\" data-kid=\"1-1-1-3\" data-name=\"mobile menu toggle button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-menu\" data-kid=\"1-1-1-3-1\" data-name=\"menu hamburger icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"container pb-10\" data-kid=\"1-2\" data-name=\"main content container\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"hero\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"hero-top\" data-kid=\"1-2-1-1\" data-name=\"hero intro and actions row\">\n                <div class=\"hero-intro\" data-kid=\"1-2-1-1-1\" data-name=\"hero introduce block\">\n                    <h1 data-kid=\"1-2-1-1-1-1\" data-name=\"hero headline text\" id=\"hero-title\">\n                        Eugene F. Flores II\n                        <span data-kid=\"1-2-1-1-1-1-1\" data-name=\"hero headline period accent\">\n                            .\n                        </span>\n                    </h1>\n                    <p class=\"hero-deck\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero subtitle text\">\n                        Gameplay programmer building systems and player interactions across Unity and Godot.\n                    </p>\n                    <div class=\"hero-meta\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero quick facts metadata row\">\n                        <span data-kid=\"1-2-1-1-1-3-1\" data-name=\"hero current role and studio\">\n                            <strong data-kid=\"1-2-1-1-1-3-1-1\" data-name=\"studio name in hero meta\">\n                                NinetySix Studios\n                            </strong>\n                            · Freelance\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-3-2\" data-name=\"hero work timeline range\">\n                            <i aria-hidden=\"true\" class=\"icon-calendar-days\" data-kid=\"1-2-1-1-1-3-2-1\" data-name=\"calendar icon in hero meta\">\n                            </i>\n                            2025–Present\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-3-3\" data-name=\"hero primary tech stack list\">\n                            Unity · C# · Godot · GDScript\n                        </span>\n                    </div>\n                </div>\n                <div class=\"hero-actions\" data-kid=\"1-2-1-1-2\" data-name=\"hero action buttons group\">\n                    <a class=\"button-dark\" data-kid=\"1-2-1-1-2-1\" data-name=\"primary résumé download button\" download=\"\" href=\"docs/Flores_Resume.pdf\">\n                        <i aria-hidden=\"true\" class=\"icon-download\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"download icon\">\n                        </i>\n                        Download résumé\n                    </a>\n                    <a class=\"button-link\" data-kid=\"1-2-1-1-2-2\" data-name=\"secondary email contact button\" href=\"mailto:eFloresii@outlook.com\">\n                        <i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"envelope icon\">\n                        </i>\n                        Email Eugene\n                    </a>\n                </div>\n            </div>\n            <div class=\"proof-heading\" data-kid=\"1-2-1-2\" data-name=\"featured work section heading row\">\n                <h2 data-kid=\"1-2-1-2-1\" data-name=\"featured work section title\">\n                    Selected work\n                </h2>\n                <a data-kid=\"1-2-1-2-2\" data-name=\"view all projects link\" href=\"#projects\">\n                    Browse all projects\n                    <span aria-hidden=\"true\" data-kid=\"1-2-1-2-2-1\" data-name=\"external link arrow glyph\">\n                        ↘\n                    </span>\n                </a>\n            </div>\n            <div class=\"proof-grid\" data-kid=\"1-2-1-3\" data-name=\"selected work project grid\">\n                <article class=\"proof proof-main\" data-kid=\"1-2-1-3-1\" data-name=\"featured project card\">\n                    <a aria-label=\"View Langit Lupa: Office Wars on Steam\" data-kid=\"1-2-1-3-1-1\" data-name=\"featured project cover image link\" href=\"https://store.steampowered.com/app/3428410/Langit_Lupa_Office_Wars/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        <img alt=\"Langit Lupa: Office Wars game artwork\" class=\"proof-image\" data-kid=\"1-2-1-3-1-1-1\" data-name=\"game cover artwork thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/LangitLupa.png\"/>\n                    </a>\n                    <div class=\"proof-body\" data-kid=\"1-2-1-3-1-2\" data-name=\"featured project body\">\n                        <div class=\"proof-label\" data-kid=\"1-2-1-3-1-2-1\" data-name=\"featured project category label\">\n                            Released team game · Unity / C#\n                        </div>\n                        <h3 data-kid=\"1-2-1-3-1-2-2\" data-name=\"featured project title\">\n                            Langit Lupa: Office Wars\n                        </h3>\n                        <p class=\"proof-copy\" data-kid=\"1-2-1-3-1-2-3\" data-name=\"featured project description\">\n                            Programmed core player interactions and gameplay systems for a multiplayer party game released on Steam with NinetySix Studios.\n                        </p>\n                        <div class=\"proof-foot\" data-kid=\"1-2-1-3-1-2-4\" data-name=\"featured project footer row\">\n                            <a class=\"proof-link\" data-kid=\"1-2-1-3-1-2-4-1\" data-name=\"external Steam store link\" href=\"https://store.steampowered.com/app/3428410/Langit_Lupa_Office_Wars/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                View on Steam\n                                <i aria-hidden=\"true\" class=\"icon-external-link\" data-kid=\"1-2-1-3-1-2-4-1-1\" data-name=\"external link icon\">\n                                </i>\n                            </a>\n                            <span class=\"proof-note\" data-kid=\"1-2-1-3-1-2-4-2\" data-name=\"studio attribution note\">\n                                NinetySix Studios · Freelance\n                            </span>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"proof proof-small\" data-kid=\"1-2-1-3-2\" data-name=\"small project card\">\n                    <a aria-label=\"Play Fruited to Fight on itch.io\" data-kid=\"1-2-1-3-2-1\" data-name=\"small project cover image link\" href=\"https://huge-games.itch.io/fruited-to-fight\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        <img alt=\"Fruited to Fight original game artwork\" class=\"proof-image\" data-kid=\"1-2-1-3-2-1-1\" data-name=\"game cover artwork thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/Fruited%20to%20Fight%20GDD.png\"/>\n                    </a>\n                    <div class=\"proof-body\" data-kid=\"1-2-1-3-2-2\" data-name=\"small project body\">\n                        <div class=\"proof-label\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"small project category label\">\n                            Awarded jam game · Unity\n                        </div>\n                        <h3 data-kid=\"1-2-1-3-2-2-2\" data-name=\"small project title\">\n                            Fruited to Fight\n                        </h3>\n                        <p class=\"proof-copy\" data-kid=\"1-2-1-3-2-2-3\" data-name=\"small project description\">\n                            A 2D roguelite built in a one-week jam sprint; earned 2nd Place Judges’ Pick at Pixel Forge Jam 2026.\n                        </p>\n                        <div class=\"proof-foot\" data-kid=\"1-2-1-3-2-2-4\" data-name=\"small project footer row\">\n                            <a class=\"proof-link\" data-kid=\"1-2-1-3-2-2-4-1\" data-name=\"external itch.io play link\" href=\"https://huge-games.itch.io/fruited-to-fight\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                Play on itch.io\n                                <i aria-hidden=\"true\" class=\"icon-external-link\" data-kid=\"1-2-1-3-2-2-4-1-1\" data-name=\"external link icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"proof proof-small\" data-kid=\"1-2-1-3-3\" data-name=\"small project card\">\n                    <a aria-label=\"Play Michelle on itch.io\" data-kid=\"1-2-1-3-3-1\" data-name=\"small project cover image link\" href=\"https://huge-games.itch.io/michelle\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        <img alt=\"Michelle Godot horror game capture\" class=\"proof-image\" data-kid=\"1-2-1-3-3-1-1\" data-name=\"game cover artwork thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/Michelle.gif\"/>\n                    </a>\n                    <div class=\"proof-body\" data-kid=\"1-2-1-3-3-2\" data-name=\"small project body\">\n                        <div class=\"proof-label\" data-kid=\"1-2-1-3-3-2-1\" data-name=\"small project category label\">\n                            Godot game · GDScript\n                        </div>\n                        <h3 data-kid=\"1-2-1-3-3-2-2\" data-name=\"small project title\">\n                            Michelle\n                        </h3>\n                        <p class=\"proof-copy\" data-kid=\"1-2-1-3-3-2-3\" data-name=\"small project description\">\n                            A 2D psychological horror game with story triggers and atmospheric lighting; placed in the Top 10 at Scream Secrets 2024.\n                        </p>\n                        <div class=\"proof-foot\" data-kid=\"1-2-1-3-3-2-4\" data-name=\"small project footer row\">\n                            <a class=\"proof-link\" data-kid=\"1-2-1-3-3-2-4-1\" data-name=\"external itch.io play link\" href=\"https://huge-games.itch.io/michelle\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                Play on itch.io\n                                <i aria-hidden=\"true\" class=\"icon-external-link\" data-kid=\"1-2-1-3-3-2-4-1-1\" data-name=\"external link icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"experience-title\" class=\"content-section\" data-kid=\"1-2-2\" data-name=\"experience section\" id=\"experience\">\n            <div class=\"section-heading\" data-kid=\"1-2-2-1\" data-name=\"experience section heading row\">\n                <h2 data-kid=\"1-2-2-1-1\" data-name=\"experience section title\" id=\"experience-title\">\n                    Professional work\n                </h2>\n                <p data-kid=\"1-2-2-1-2\" data-name=\"experience section description\">\n                    Paid work with a game studio and a campus client, listed separately from independent games.\n                </p>\n            </div>\n            <div class=\"career-list\" data-kid=\"1-2-2-2\" data-name=\"professional experience list\">\n                <article class=\"career-row\" data-kid=\"1-2-2-2-1\" data-name=\"professional experience entry\">\n                    <div data-kid=\"1-2-2-2-1-1\" data-name=\"experience entry role block\">\n                        <div class=\"career-role\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"job role title\">\n                            Unity gameplay programmer\n                        </div>\n                        <div class=\"career-company\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"company name\">\n                            NinetySix Studios\n                        </div>\n                        <div class=\"career-type\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"engagement type label\">\n                            Freelance\n                        </div>\n                    </div>\n                    <ul class=\"career-bullets\" data-kid=\"1-2-2-2-1-2\" data-name=\"experience bullets list\">\n                        <li data-kid=\"1-2-2-2-1-2-1\" data-name=\"experience achievement bullet\">\n                            Co-developed gameplay mechanics and reusable C# systems for a multiplayer party game released on Steam.\n                        </li>\n                        <li data-kid=\"1-2-2-2-1-2-2\" data-name=\"experience achievement bullet\">\n                            Worked with Observer and Factory patterns, ScriptableObject-based tuning and editor tooling.\n                        </li>\n                    </ul>\n                    <div class=\"career-dates\" data-kid=\"1-2-2-2-1-3\" data-name=\"experience dates block\">\n                        <strong data-kid=\"1-2-2-2-1-3-1\" data-name=\"experience date range\">\n                            2025–Present\n                        </strong>\n                        Studio work\n                    </div>\n                </article>\n                <article class=\"career-row\" data-kid=\"1-2-2-2-2\" data-name=\"professional experience entry\">\n                    <div data-kid=\"1-2-2-2-2-1\" data-name=\"experience entry role block\">\n                        <div class=\"career-role\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"job role title\">\n                            Solo game developer\n                        </div>\n                        <div class=\"career-company\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"client organization name\">\n                            Mapúa Malayan Colleges Mindanao\n                        </div>\n                        <div class=\"career-type\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"client engagement type label\">\n                            Client project · M2VEX\n                        </div>\n                    </div>\n                    <ul class=\"career-bullets\" data-kid=\"1-2-2-2-2-2\" data-name=\"experience bullets list\">\n                        <li data-kid=\"1-2-2-2-2-2-1\" data-name=\"experience achievement bullet\">\n                            Built an interactive virtual campus tour using Full-Motion Video (FMV).\n                        </li>\n                        <li data-kid=\"1-2-2-2-2-2-2\" data-name=\"experience achievement bullet\">\n                            Implemented path-selection nodes and navigation between campus scenes.\n                        </li>\n                    </ul>\n                    <div class=\"career-dates\" data-kid=\"1-2-2-2-2-3\" data-name=\"experience dates block\">\n                        <strong data-kid=\"1-2-2-2-2-3-1\" data-name=\"experience year\">\n                            2024\n                        </strong>\n                        MMCM\n                    </div>\n                </article>\n            </div>\n            <div class=\"independent-intro mt-10\" data-kid=\"1-2-2-3\" data-name=\"independent games intro row\">\n                <h3 data-kid=\"1-2-2-3-1\" data-name=\"independent games heading\">\n                    Independent games & jams\n                </h3>\n                <p data-kid=\"1-2-2-3-2\" data-name=\"independent games description\">\n                    Rapid prototypes, jam builds and personal projects across Unity and Godot.\n                </p>\n            </div>\n            <div class=\"jam-lines\" data-kid=\"1-2-2-4\" data-name=\"jam projects list container\">\n                <div class=\"jam-line\" data-kid=\"1-2-2-4-1\" data-name=\"jam project row\">\n                    <span class=\"jam-name\" data-kid=\"1-2-2-4-1-1\" data-name=\"jam project name\">\n                        Fruited to Return\n                    </span>\n                    <span class=\"jam-kind\" data-kid=\"1-2-2-4-1-2\" data-name=\"jam project details\">\n                        Unity · precision platformer · 48-hour build\n                    </span>\n                </div>\n                <div class=\"jam-line\" data-kid=\"1-2-2-4-2\" data-name=\"jam project row\">\n                    <span class=\"jam-name\" data-kid=\"1-2-2-4-2-1\" data-name=\"jam project name\">\n                        Michelle\n                    </span>\n                    <span class=\"jam-kind\" data-kid=\"1-2-2-4-2-2\" data-name=\"jam project details\">\n                        Godot · story triggers · Top 10 at Scream Secrets\n                    </span>\n                </div>\n                <div class=\"jam-line\" data-kid=\"1-2-2-4-3\" data-name=\"jam project row\">\n                    <span class=\"jam-name\" data-kid=\"1-2-2-4-3-1\" data-name=\"jam project name\">\n                        Plate Pals\n                    </span>\n                    <span class=\"jam-kind\" data-kid=\"1-2-2-4-3-2\" data-name=\"jam project details\">\n                        Godot · delivery simulator · Micro-Food Jam\n                    </span>\n                </div>\n                <div class=\"jam-line\" data-kid=\"1-2-2-4-4\" data-name=\"jam project row\">\n                    <span class=\"jam-name\" data-kid=\"1-2-2-4-4-1\" data-name=\"jam project name\">\n                        Frigg’s Grill n Thrill\n                    </span>\n                    <span class=\"jam-kind\" data-kid=\"1-2-2-4-4-2\" data-name=\"jam project details\">\n                        Unity · cooking horror · Top 30, Scream Jam\n                    </span>\n                </div>\n                <div class=\"jam-line\" data-kid=\"1-2-2-4-5\" data-name=\"jam project row\">\n                    <span class=\"jam-name\" data-kid=\"1-2-2-4-5-1\" data-name=\"jam project name\">\n                        Fruited to Fight\n                    </span>\n                    <span class=\"jam-kind\" data-kid=\"1-2-2-4-5-2\" data-name=\"jam project details\">\n                        Unity · 2D roguelite · 2nd Place Judges’ Pick\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"recognition-title\" class=\"content-section\" data-kid=\"1-2-3\" data-name=\"recognition section\" id=\"recognition\">\n            <div class=\"section-heading\" data-kid=\"1-2-3-1\" data-name=\"recognition section heading row\">\n                <h2 data-kid=\"1-2-3-1-1\" data-name=\"recognition section title\" id=\"recognition-title\">\n                    Recognition & client feedback\n                </h2>\n                <p data-kid=\"1-2-3-1-2\" data-name=\"recognition section description\">\n                    Competition recognition and contract feedback are shown as separate forms of evidence.\n                </p>\n            </div>\n            <div class=\"evidence-grid\" data-kid=\"1-2-3-2\" data-name=\"recognition evidence two-column grid\">\n                <div class=\"evidence-column\" data-kid=\"1-2-3-2-1\" data-name=\"award evidence column\">\n                    <h3 data-kid=\"1-2-3-2-1-1\" data-name=\"award column title\">\n                        Award\n                    </h3>\n                    <article class=\"award-feature\" data-kid=\"1-2-3-2-1-2\" data-name=\"award feature card\">\n                        <img alt=\"Pixel Forge Jam 2026 certificate\" class=\"award-image\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"award certificate image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/Certificate_of_Achievement_Pixel_Forge_Jam_2026_1.png\"/>\n                        <div data-kid=\"1-2-3-2-1-2-2\" data-name=\"award detail block\">\n                            <div class=\"award-kicker\" data-kid=\"1-2-3-2-1-2-2-1\" data-name=\"award placement label\">\n                                2nd Place · Judges’ Pick\n                            </div>\n                            <h4 data-kid=\"1-2-3-2-1-2-2-2\" data-name=\"award name heading\">\n                                Pixel Forge Jam 2026\n                            </h4>\n                            <p data-kid=\"1-2-3-2-1-2-2-3\" data-name=\"award description text\">\n                                Co-developed and optimized\n                                <em data-kid=\"1-2-3-2-1-2-2-3-1\" data-name=\"highlighted game title in award\">\n                                    Fruited to Fight\n                                </em>\n                                during a one-week game jam sprint.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n                <div class=\"evidence-column\" data-kid=\"1-2-3-2-2\" data-name=\"client feedback evidence column\">\n                    <h3 data-kid=\"1-2-3-2-2-1\" data-name=\"client feedback column title\">\n                        Upwork client feedback\n                    </h3>\n                    <div class=\"feedback-list\" data-kid=\"1-2-3-2-2-2\" data-name=\"client feedback list\">\n                        <article class=\"feedback-row\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"client feedback entry\">\n                            <div class=\"feedback-client\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"client name and project label\">\n                                Chronigma · QA testing\n                            </div>\n                            <h4 data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"feedback summary heading\">\n                                Gameplay testing and bug reports\n                            </h4>\n                            <p data-kid=\"1-2-3-2-2-2-1-3\" data-name=\"feedback detail text\">\n                                Identified critical issues in a Steam game and delivered detailed design reports and bug sheets within a three-hour turnaround.\n                            </p>\n                        </article>\n                        <article class=\"feedback-row\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"client feedback entry\">\n                            <div class=\"feedback-client\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"client name and project label\">\n                                Unity prototype · 7 days\n                            </div>\n                            <h4 data-kid=\"1-2-3-2-2-2-2-2\" data-name=\"feedback summary heading\">\n                                Not So Legal Internet Cafe\n                            </h4>\n                            <p data-kid=\"1-2-3-2-2-2-2-3\" data-name=\"feedback detail text\">\n                                Created a mechanics prototype. Client feedback singled out the systems design and organization among five developers.\n                            </p>\n                        </article>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"projects-title\" class=\"project-section\" data-kid=\"1-2-4\" data-name=\"projects section\" id=\"projects\">\n            <div class=\"section-heading\" data-kid=\"1-2-4-1\" data-name=\"projects section heading row\">\n                <h2 data-kid=\"1-2-4-1-1\" data-name=\"projects section title\" id=\"projects-title\">\n                    All projects\n                </h2>\n                <p data-kid=\"1-2-4-1-2\" data-name=\"projects section description\">\n                    Ten games across Unity, Godot, client work and game jams. Featured work stays above for an at-a-glance review.\n                </p>\n            </div>\n            <div class=\"filter-bar\" data-kid=\"1-2-4-2\" data-name=\"projects filter bar\">\