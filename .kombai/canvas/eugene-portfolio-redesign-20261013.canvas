4-1\" data-name=\"experience headline column\">\n                <h2 class=\"text-[clamp(32px,4vw,44px)] font-semibold leading-[1.05] tracking-[-0.055em]\" data-kid=\"1-2-4-1-1\" data-name=\"experience section headline\" id=\"experience-title\">\n                    Experience\n                </h2>\n                <p class=\"mt-4 max-w-[360px] text-[16px] leading-[1.65] text-[#5f5f5d]\" data-kid=\"1-2-4-1-2\" data-name=\"experience section description\">\n                    Professional and client work, distinct from independent game jams.\n                </p>\n            </div>\n            <div class=\"divide-y divide-[#e2dfd5] border-y border-[#d9d6cb]\" data-kid=\"1-2-4-2\" data-name=\"experience entries list container\">\n                <article class=\"py-6 md:py-7\" data-kid=\"1-2-4-2-1\" data-name=\"NinetySix Studios experience entry\">\n                    <div class=\"grid gap-2 sm:grid-cols-[1fr_auto] sm:items-start\" data-kid=\"1-2-4-2-1-1\" data-name=\"NinetySix Studios role header row\">\n                        <div data-kid=\"1-2-4-2-1-1-1\" data-name=\"NinetySix Studios role info block\">\n                            <h3 class=\"text-[22px] font-semibold tracking-[-0.035em]\" data-kid=\"1-2-4-2-1-1-1-1\" data-name=\"NinetySix Studios role title\">\n                                C# Unity Programmer\n                            </h3>\n                            <p class=\"mt-1 text-[16px] text-[#5f5f5d]\" data-kid=\"1-2-4-2-1-1-1-2\" data-name=\"NinetySix Studios company label\">\n                                NinetySix Studios · Freelance\n                            </p>\n                        </div>\n                        <p class=\"text-[14px] font-medium sm:text-right\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"NinetySix Studios duration label\">\n                            2025–Present\n                        </p>\n                    </div>\n                    <ul class=\"mt-4 grid gap-2 pl-5 text-[15px] leading-[1.6] text-[#3d3d3b] marker:text-[#5f5f5d]\" data-kid=\"1-2-4-2-1-2\" data-name=\"NinetySix Studios responsibilities list\">\n                        <li data-kid=\"1-2-4-2-1-2-1\" data-name=\"NinetySix Studios responsibility item\">\n                            Co-developed core gameplay mechanics and reusable C# systems.\n                        </li>\n                        <li data-kid=\"1-2-4-2-1-2-2\" data-name=\"NinetySix Studios design patterns item\">\n                            Applied Observer, Factory and interface-based patterns; built data-driven workflows with Scriptable Objects.\n                        </li>\n                        <li data-kid=\"1-2-4-2-1-2-3\" data-name=\"NinetySix Studios reflection tooling item\">\n                            Used C# reflection to extend flexible object structures and editor tooling.\n                        </li>\n                    </ul>\n                </article>\n                <article class=\"py-6 md:py-7\" data-kid=\"1-2-4-2-2\" data-name=\"M2VEX client experience entry\">\n                    <div class=\"grid gap-2 sm:grid-cols-[1fr_auto] sm:items-start\" data-kid=\"1-2-4-2-2-1\" data-name=\"M2VEX role header row\">\n                        <div data-kid=\"1-2-4-2-2-1-1\" data-name=\"M2VEX role info block\">\n                            <h3 class=\"text-[22px] font-semibold tracking-[-0.035em]\" data-kid=\"1-2-4-2-2-1-1-1\" data-name=\"M2VEX role title\">\n                                Solo game developer\n                            </h3>\n                            <p class=\"mt-1 text-[16px] text-[#5f5f5d]\" data-kid=\"1-2-4-2-2-1-1-2\" data-name=\"M2VEX client label\">\n                                Mapúa Malayan Colleges Mindanao · Client project\n                            </p>\n                        </div>\n                        <p class=\"text-[14px] font-medium sm:text-right\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"M2VEX duration label\">\n                            2024\n                        </p>\n                    </div>\n                    <p class=\"mt-4 max-w-[640px] text-[15px] leading-[1.65] text-[#3d3d3b]\" data-kid=\"1-2-4-2-2-2\" data-name=\"M2VEX role description\">\n                        Developed M2VEX, an interactive virtual campus tour, including full-motion-video playback logic, UI navigation, and path-selection nodes.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"independent-title\" class=\"border-t border-[#d9d6cb] py-12 md:py-16\" data-kid=\"1-2-5\" data-name=\"independent development section\">\n            <div class=\"grid gap-3 sm:grid-cols-[0.7fr_1.3fr] sm:gap-10\" data-kid=\"1-2-5-1\" data-name=\"independent development layout grid\">\n                <h2 class=\"text-[27px] font-semibold tracking-[-0.04em]\" data-kid=\"1-2-5-1-1\" data-name=\"independent development section headline\" id=\"independent-title\">\n                    Independent development\n                </h2>\n                <div data-kid=\"1-2-5-1-2\" data-name=\"independent development text block\">\n                    <p class=\"max-w-[700px] text-[16px] leading-[1.65] text-[#3d3d3b]\" data-kid=\"1-2-5-1-2-1\" data-name=\"independent development description\">\n                        Unity and Godot game jams have been a setting for rapid prototyping, gameplay-loop design, physics and controls tuning, and story-driven events.\n                    </p>\n                    <p class=\"mt-3 text-[14px] leading-[1.6] text-[#5f5f5d]\" data-kid=\"1-2-5-1-2-2\" data-name=\"independent development examples text\">\n                        Examples: Fruited to Fight · Fruited to Return · Michelle · Plate Pals · Frigg’s Grill n Thrill\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"evidence-title\" class=\"border-t border-[#d9d6cb] py-20 md:py-24\" data-kid=\"1-2-6\" data-name=\"awards and feedback section\">\n            <h2 class=\"max-w-[650px] text-[clamp(32px,4vw,46px)] font-semibold leading-[1.07] tracking-[-0.055em]\" data-kid=\"1-2-6-1\" data-name=\"awards and feedback section headline\" id=\"evidence-title\">\n                Awards & client feedback\n            </h2>\n            <div class=\"mt-9 grid gap-9 md:grid-cols-[0.92fr_1.08fr]\" data-kid=\"1-2-6-2\" data-name=\"awards and feedback grid\">\n                <article class=\"border-t border-[#1c1c1c] pt-5\" data-kid=\"1-2-6-2-1\" data-name=\"Pixel Forge Jam award card\">\n                    <img alt=\"Pixel Forge Jam 2026 certificate recognizing a second-place Judges’ Pick.\" class=\"mb-5 max-h-[220px] w-full border border-[#eceae4] bg-[#fcfbf8] object-contain object-left\" data-kid=\"1-2-6-2-1-1\" data-name=\"Pixel Forge Jam certificate image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/Certificate_of_Achievement_Pixel_Forge_Jam_2026_1.png\"/>\n                    <p class=\"text-[14px] font-medium text-[#5f5f5d]\" data-kid=\"1-2-6-2-1-2\" data-name=\"Pixel Forge Jam award category\">\n                        Game-jam award · Pixel Forge Jam 2026\n                    </p>\n                    <h3 class=\"mt-1 text-[21px] font-semibold\" data-kid=\"1-2-6-2-1-3\" data-name=\"Pixel Forge Jam award title\">\n                        Fruited to Fight · 2nd Place Judges’ Pick\n                    </h3>\n                    <p class=\"mt-2 text-[15px] leading-[1.6] text-[#3d3d3b]\" data-kid=\"1-2-6-2-1-4\" data-name=\"Pixel Forge Jam award description\">\n                        Co-developed and optimized the 2D roguelite in a one-week game-jam sprint.\n                    </p>\n                </article>\n                <div class=\"border-t border-[#1c1c1c] pt-5\" data-kid=\"1-2-6-2-2\" data-name=\"client feedback column\">\n                    <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-2-6-2-2-1\" data-name=\"client feedback title\">\n                        Upwork client feedback\n                    </h3>\n                    <article class=\"border-b border-[#e2dfd5] py-5\" data-kid=\"1-2-6-2-2-2\" data-name=\"Chronigma client feedback card\">\n                        <p class=\"text-[14px] text-[#5f5f5d]\" data-kid=\"1-2-6-2-2-2-1\" data-name=\"Chronigma feedback category\">\n                            QA testing · Chronigma · Client rating 5.0\n                        </p>\n                        <h4 class=\"mt-1 text-[18px] font-semibold\" data-kid=\"1-2-6-2-2-2-2\" data-name=\"Chronigma feedback title\">\n                            Steam game testing\n                        </h4>\n                        <p class=\"mt-2 text-[15px] leading-[1.6] text-[#3d3d3b]\" data-kid=\"1-2-6-2-2-2-3\" data-name=\"Chronigma feedback description\">\n                            Delivered gameplay findings, design reports, and bug sheets with a three-hour turnaround.\n                        </p>\n                    </article>\n                    <article class=\"py-5\" data-kid=\"1-2-6-2-2-3\" data-name=\"Not So Legal client feedback card\">\n                        <p class=\"text-[14px] text-[#5f5f5d]\" data-kid=\"1-2-6-2-2-3-1\" data-name=\"Not So Legal feedback category\">\n                            Unity prototype · Upwork · Client rating 5.0\n                        </p>\n                        <h4 class=\"mt-1 text-[18px] font-semibold\" data-kid=\"1-2-6-2-2-3-2\" data-name=\"Not So Legal feedback title\">\n                            Not So Legal Internet Cafe\n                        </h4>\n                        <p class=\"mt-2 text-[15px] leading-[1.6] text-[#3d3d3b]\" data-kid=\"1-2-6-2-2-3-3\" data-name=\"Not So Legal feedback description\">\n                            Created a mechanics prototype over seven days; client feedback highlighted the organization of the systems design.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"about-title\" class=\"grid items-center gap-9 border-t border-[#d9d6cb] py-16 md:grid-cols-[230px_1fr] md:gap-16 md:py-20\" data-kid=\"1-2-7\" data-name=\"about section\" id=\"about\">\n            <img alt=\"Portrait of game developer Eugene F. Flores II.\" class=\"aspect-square w-full border border-[#e2dfd5] object-cover\" data-kid=\"1-2-7-1\" data-name=\"Eugene portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/FormalPic.png\"/>\n            <div data-kid=\"1-2-7-2\" data-name=\"about text column\">\n                <h2 class=\"text-[32px] font-semibold tracking-[-0.05em]\" data-kid=\"1-2-7-2-1\" data-name=\"about section headline\" id=\"about-title\">\n                    About Eugene\n                </h2>\n                <p class=\"mt-4 max-w-[730px] text-[16px] leading-[1.7] text-[#3d3d3b]\" data-kid=\"1-2-7-2-2\" data-name=\"about section description\">\n                    I’m a game developer who approaches systems from both the player’s and programmer’s side. My work spans Unity and Godot—from team gameplay systems to solo client work, prototypes, and game jams—with a focus on implementation, debugging, and clear documentation.\n                </p>\n                <div class=\"mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[14px] text-[#5f5f5d]\" data-kid=\"1-2-7-2-3\" data-name=\"skills tags row\">\n                    <span data-kid=\"1-2-7-2-3-1\" data-name=\"C# Unity skill tag\">\n                        C# · Unity\n                    </span>\n                    <span data-kid=\"1-2-7-2-3-2\" data-name=\"Godot skill tag\">\n                        GDScript · Godot\n                    </span>\n                    <span data-kid=\"1-2-7-2-3-3\" data-name=\"Figma Aseprite skill tag\">\n                        Figma · Aseprite\n                    </span>\n                    <span data-kid=\"1-2-7-2-3-4\" data-name=\"HTML CSS skill tag\">\n                        HTML · CSS\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"contact-title\" class=\"border-t border-[#d9d6cb] py-16 md:py-20\" data-kid=\"1-2-8\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"grid gap-7 md:grid-cols-[1fr_auto] md:items-end\" data-kid=\"1-2-8-1\" data-name=\"contact header row\">\n                <div data-kid=\"1-2-8-1-1\" data-name=\"contact headline block\">\n                    <h2 class=\"max-w-[660px] text-[clamp(36px,4.8vw,58px)] font-semibold leading-[1.04] tracking-[-0.06em]\" data-kid=\"1-2-8-1-1-1\" data-name=\"contact section headline\" id=\"contact-title\">\n                        Let’s talk about the work.\n                    </h2>\n                    <a class=\"mt-5 inline-block text-[18px] font-medium underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-8-1-1-2\" data-name=\"contact email link\" href=\"mailto:eFloresii@outlook.com\">\n                        Email Eugene\n                        <span aria-hidden=\"true\" data-kid=\"1-2-8-1-1-2-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <div class=\"flex flex-wrap gap-x-5 gap-y-3 text-[14px]\" data-kid=\"1-2-8-1-2\" data-name=\"contact external links row\">\n                    <a class=\"underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-8-1-2-1\" data-name=\"GitHub external link\" href=\"https://github.com/Eugene-F-FloresII\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        GitHub ↗\n                    </a>\n                    <a class=\"underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-8-1-2-2\" data-name=\"LinkedIn external link\" href=\"https://www.linkedin.com/in/eugenefloresii/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        LinkedIn ↗\n                    </a>\n                    <a class=\"underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-8-1-2-3\" data-name=\"itch.io external link\" href=\"https://huge-games.itch.io/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        HuGe on itch.io ↗\n                    </a>\n                    <a class=\"underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-8-1-2-4\" data-name=\"download résumé file link\" download=\"\" href=\"docs/Flores_Resume.pdf\">\n                        Download résumé ↓\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#e2dfd5]\" data-kid=\"1-3\" data-name=\"site footer bar\">\n        <div class=\"mx-auto flex max-w-[1232px] flex-col gap-2 px-6 py-6 text-[13px] text-[#5f5f5d] sm:flex-row sm:items-center sm:justify-between md:px-10\" data-kid=\"1-3-1\" data-name=\"footer layout row\">\n            <p data-kid=\"1-3-1-1\" data-name=\"footer copyright text\">\n                © 2026 Eugene F. Flores II\n            </p>\n            <a class=\"w-fit underline underline-offset-4 hover:text-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-3-1-2\" data-name=\"back to top link\" href=\"#top\">\n                Back to top ↑\n            </a>\n        </div>\n    </footer>\n</div>\n<script>\n    (() => {\n  const buttons = Array.from(document.querySelectorAll('.project-filter'));\n  const rows = Array.from(document.querySelectorAll('.project-row'));\n  const count = document.getElementById('project-count');\n  buttons.forEach((button) => {\n    button.addEventListener('click', () => {\n      const filter = button.dataset.filter;\n      let shown = 0;\n      buttons.forEach((item) => {\n        const active = item === button;\n        item.setAttribute('aria-pressed', String(active));\n        item.classList.toggle('border-[#1c1c1c]', active);\n        item.classList.toggle('border-transparent', !active);\n        item.classList.toggle('font-medium', active);\n        item.classList.toggle('text-[#5f5f5d]', !active);\n      });\n      rows.forEach((row) => {\n        const visible = filter === 'all' || row.dataset.tags.split(',').includes(filter);\n        row.hidden = !visible;\n        if (visible) shown += 1;\n      });\n      count.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}`;\n    });\n  });\n})();\n</script>\n",
