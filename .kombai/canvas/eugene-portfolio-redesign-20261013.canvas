      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#f7f4ed] font-['DM_Sans',ui-sans-serif,system-ui] text-[#1c1c1c]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#eceae4]\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <nav aria-label=\"Main navigation\" class=\"mx-auto flex max-w-[1232px] items-center justify-between gap-8 px-6 py-5 md:px-10\" data-kid=\"1-1-1\" data-name=\"main navigation bar\">\n            <a class=\"text-[15px] font-semibold tracking-[-0.03em] text-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-1-1-1\" data-name=\"site name brand link\" href=\"#top\">\n                Eugene F. Flores II\n            </a>\n            <div class=\"hidden items-center gap-8 text-[14px] text-[#5f5f5d] md:flex\" data-kid=\"1-1-1-2\" data-name=\"primary nav link group\">\n                <a class=\"underline decoration-transparent underline-offset-4 hover:text-[#1c1c1c] hover:decoration-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link to selected work\" href=\"#work\">\n                    Selected work\n                </a>\n                <a class=\"underline decoration-transparent underline-offset-4 hover:text-[#1c1c1c] hover:decoration-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to all games\" href=\"#projects\">\n                    All games\n                </a>\n                <a class=\"underline decoration-transparent underline-offset-4 hover:text-[#1c1c1c] hover:decoration-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-1-1-2-3\" data-name=\"nav link to experience\" href=\"#experience\">\n                    Experience\n                </a>\n                <a class=\"underline decoration-transparent underline-offset-4 hover:text-[#1c1c1c] hover:decoration-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-1-1-2-4\" data-name=\"nav link to about\" href=\"#about\">\n                    About\n                </a>\n            </div>\n            <a class=\"inline-flex min-h-11 items-center border border-[#1c1c1c] px-4 text-[14px] font-medium hover:bg-[#1c1c1c] hover:text-[#fcfbf8] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-1-1-3\" data-name=\"download résumé button link\" href=\"docs/Flores_Resume.pdf\">\n                Download résumé\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto max-w-[1232px] px-6 md:px-10\" data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"grid items-center gap-10 border-b border-[#eceae4] py-12 md:grid-cols-[0.88fr_1.12fr] md:gap-16 md:py-20\" data-kid=\"1-2-1\" data-name=\"hero introduction section\">\n            <div class=\"max-w-[510px]\" data-kid=\"1-2-1-1\" data-name=\"hero text column\">\n                <p class=\"mb-5 text-[16px] font-medium text-[#5f5f5d]\" data-kid=\"1-2-1-1-1\" data-name=\"hero name eyebrow label\">\n                    Eugene F. Flores II\n                </p>\n                <h1 class=\"max-w-[560px] text-[clamp(42px,5.2vw,68px)] font-semibold leading-[1.02] tracking-[-0.065em]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline text\" id=\"hero-title\">\n                    Gameplay programmer across Unity and Godot.\n                </h1>\n                <p class=\"mt-6 max-w-[455px] text-[17px] leading-[1.65] text-[#3d3d3b]\" data-kid=\"1-2-1-1-3\" data-name=\"hero value proposition paragraph\">\n                    I build the mechanics behind the moment: player interactions, responsive movement, and event-driven systems.\n                </p>\n                <div class=\"mt-8 border-l border-[#c8c4b8] pl-4\" data-kid=\"1-2-1-1-4\" data-name=\"current role callout box\">\n                    <p class=\"text-[14px] leading-[1.55]\" data-kid=\"1-2-1-1-4-1\" data-name=\"current role details text\">\n                        <span class=\"font-semibold\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"current role title text\">\n                            Freelance · NinetySix Studios\n                        </span>\n                        <br data-kid=\"1-2-1-1-4-1-2\" data-name=\"role details line break\"/>\n                        <span class=\"text-[#5f5f5d]\" data-kid=\"1-2-1-1-4-1-3\" data-name=\"current role summary text\">\n                            Unity gameplay programming · 2025–Present\n                        </span>\n                    </p>\n                </div>\n                <div class=\"mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-[14px]\" data-kid=\"1-2-1-1-5\" data-name=\"hero call-to-action link row\">\n                    <a class=\"font-semibold underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-1-1-5-1\" data-name=\"call-to-action link to gameplay systems\" href=\"#work\">\n                        See gameplay systems\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-5-1-1\" data-name=\"down arrow indicator icon\">\n                            ↓\n                        </span>\n                    </a>\n                    <a class=\"text-[#5f5f5d] underline underline-offset-4 hover:text-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-1-1-5-2\" data-name=\"call-to-action email link\" href=\"mailto:eFloresii@outlook.com\">\n                        Email Eugene\n                    </a>\n                </div>\n            </div>\n            <figure class=\"m-0 min-w-0\" data-kid=\"1-2-1-2\" data-name=\"hero featured game media figure\">\n                <div class=\"overflow-hidden border border-[#eceae4] bg-[#eceae4]\" data-kid=\"1-2-1-2-1\" data-name=\"hero game media image frame\">\n                    <img alt=\"Gameplay capture from Fruited to Return, a precision platformer built in Unity.\" class=\"aspect-[1.48/1] w-full object-cover\" data-kid=\"1-2-1-2-1-1\" data-name=\"hero gameplay capture image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/FruitedToReturn.gif\"/>\n                </div>\n                <figcaption class=\"flex flex-wrap items-baseline justify-between gap-2 pt-3 text-[13px] text-[#5f5f5d]\" data-kid=\"1-2-1-2-2\" data-name=\"hero media caption row\">\n                    <span data-kid=\"1-2-1-2-2-1\" data-name=\"hero media caption text\">\n                        <span class=\"font-medium text-[#1c1c1c]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"hero media title text\">\n                            Fruited to Return\n                        </span>\n                        · Precision platforming & input tuning\n                    </span>\n                    <a class=\"font-medium text-[#1c1c1c] underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-1-2-2-2\" data-name=\"external itch.io play link\" href=\"https://huge-games.itch.io/fruited-to-return\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Play on itch.io\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </figcaption>\n            </figure>\n        </section>\n        <section aria-labelledby=\"work-title\" class=\"py-20 md:py-28\" data-kid=\"1-2-2\" data-name=\"selected work section\" id=\"work\">\n            <div class=\"mb-10 grid items-end gap-4 md:grid-cols-[1fr_auto]\" data-kid=\"1-2-2-1\" data-name=\"selected work section header row\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"selected work headline block\">\n                    <h2 class=\"max-w-[720px] text-[clamp(32px,4vw,48px)] font-semibold leading-[1.07] tracking-[-0.055em]\" data-kid=\"1-2-2-1-1-1\" data-name=\"selected work section headline\" id=\"work-title\">\n                        The systems behind the game.\n                    </h2>\n                    <p class=\"mt-4 max-w-[570px] text-[16px] leading-[1.6] text-[#5f5f5d]\" data-kid=\"1-2-2-1-1-2\" data-name=\"selected work section description\">\n                        A few mechanics I’ve built, each connected to the project where it lives.\n                    </p>\n                </div>\n                <a class=\"w-fit text-[14px] font-medium underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-2-1-2\" data-name=\"browse all projects link\" href=\"#projects\">\n                    Browse all 10 projects\n                    <span aria-hidden=\"true\" data-kid=\"1-2-2-1-2-1\" data-name=\"down arrow indicator icon\">\n                        ↓\n                    </span>\n                </a>\n            </div>\n            <article class=\"grid overflow-hidden border border-[#e2dfd5] bg-[#fcfbf8] md:grid-cols-[1.08fr_0.92fr]\" data-kid=\"1-2-2-2\" data-name=\"Langit Lupa featured project card\">\n                <figure class=\"m-0 min-h-[260px] bg-[#eceae4] md:min-h-[400px]\" data-kid=\"1-2-2-2-1\" data-name=\"Langit Lupa key art figure\">\n                    <img alt=\"Key art for Langit Lupa: Office Wars, the multiplayer party game released on Steam.\" class=\"h-full min-h-[260px] w-full object-cover md:min-h-[400px]\" data-kid=\"1-2-2-2-1-1\" data-name=\"Langit Lupa key art image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/LangitLupa.png\"/>\n                </figure>\n                <div class=\"flex flex-col justify-center p-7 md:p-10 lg:p-14\" data-kid=\"1-2-2-2-2\" data-name=\"Langit Lupa project details column\">\n                    <p class=\"text-[14px] font-medium text-[#5f5f5d]\" data-kid=\"1-2-2-2-2-1\" data-name=\"Langit Lupa project category label\">\n                        Released team game · Unity / C#\n                    </p>\n                    <h3 class=\"mt-3 text-[32px] font-semibold leading-tight tracking-[-0.045em] md:text-[38px]\" data-kid=\"1-2-2-2-2-2\" data-name=\"Langit Lupa project title\">\n                        Langit Lupa: Office Wars\n                    </h3>\n                    <p class=\"mt-5 max-w-[460px] text-[16px] leading-[1.7] text-[#3d3d3b]\" data-kid=\"1-2-2-2-2-3\" data-name=\"Langit Lupa project description\">\n                        Programmed core player interactions and gameplay systems for this Steam-released multiplayer party game, with clear documentation to support the wider team.\n                    </p>\n                    <a class=\"mt-7 inline-flex w-fit min-h-11 items-center border border-[#1c1c1c] px-4 text-[14px] font-medium hover:bg-[#1c1c1c] hover:text-[#fcfbf8] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-2-2-2-4\" data-name=\"view on Steam call-to-action button\" href=\"https://store.steampowered.com/app/3428410/Langit_Lupa_Office_Wars/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        View on Steam\n                        <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </article>\n            <article class=\"mt-5 grid items-stretch gap-0 border-y border-[#e2dfd5] py-6 md:grid-cols-[0.82fr_1.18fr] md:gap-12 md:py-8\" data-kid=\"1-2-2-3\" data-name=\"M2VEX featured project card\">\n                <div class=\"flex flex-col justify-center py-2 md:py-4\" data-kid=\"1-2-2-3-1\" data-name=\"M2VEX project details column\">\n                    <p class=\"text-[14px] font-medium text-[#5f5f5d]\" data-kid=\"1-2-2-3-1-1\" data-name=\"M2VEX project category label\">\n                        Solo client project · Unity · 2024\n                    </p>\n                    <h3 class=\"mt-2 text-[28px] font-semibold leading-tight tracking-[-0.045em]\" data-kid=\"1-2-2-3-1-2\" data-name=\"M2VEX project title\">\n                        M2VEX virtual campus tour\n                    </h3>\n                    <p class=\"mt-4 max-w-[500px] text-[16px] leading-[1.65] text-[#3d3d3b]\" data-kid=\"1-2-2-3-1-3\" data-name=\"M2VEX project description\">\n                        Built FMV playback logic, UI navigation, and path-selection nodes for an interactive MMCM campus tour.\n                    </p>\n                    <a class=\"mt-5 w-fit text-[14px] font-medium underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-2-3-1-4\" data-name=\"M2VEX itch.io profile link\" href=\"https://huge-games.itch.io/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        See HuGe’s itch.io profile\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-3-1-4-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <figure class=\"m-0 mt-6 border border-[#eceae4] bg-[#eceae4] md:mt-0\" data-kid=\"1-2-2-3-2\" data-name=\"M2VEX media figure\">\n                    <img alt=\"Frame from the M2VEX interactive video campus tour.\" class=\"aspect-[1.85/1] w-full object-cover\" data-kid=\"1-2-2-3-2-1\" data-name=\"M2VEX gameplay frame image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/M2VEX.gif\"/>\n                    <figcaption class=\"border-t border-[#e2dfd5] bg-[#fcfbf8] px-3 py-2 text-[13px] text-[#5f5f5d]\" data-kid=\"1-2-2-3-2-2\" data-name=\"M2VEX media caption bar\">\n                        M2VEX · Full-motion-video campus navigation\n                    </figcaption>\n                </figure>\n            </article>\n            <div class=\"mt-12 grid gap-x-12 gap-y-0 border-t border-[#e2dfd5] md:grid-cols-2\" data-kid=\"1-2-2-4\" data-name=\"additional mini project grid\">\n                <article class=\"grid grid-cols-[112px_1fr] gap-5 border-b border-[#e2dfd5] py-6 sm:grid-cols-[148px_1fr] md:py-8\" data-kid=\"1-2-2-4-1\" data-name=\"Michelle mini project card\">\n                    <img alt=\"Gameplay capture from Michelle, a Godot GDScript horror game.\" class=\"aspect-[1.2/1] w-full border border-[#eceae4] object-cover\" data-kid=\"1-2-2-4-1-1\" data-name=\"Michelle gameplay thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/Michelle.gif\"/>\n                    <div class=\"self-center\" data-kid=\"1-2-2-4-1-2\" data-name=\"Michelle project details block\">\n                        <p class=\"text-[13px] text-[#5f5f5d]\" data-kid=\"1-2-2-4-1-2-1\" data-name=\"Michelle project meta label\">\n                            Godot · GDScript · Game jam\n                        </p>\n                        <h3 class=\"mt-1 text-[22px] font-semibold tracking-[-0.035em]\" data-kid=\"1-2-2-4-1-2-2\" data-name=\"Michelle project title\">\n                            Story triggers and atmosphere\n                        </h3>\n                        <p class=\"mt-2 text-[15px] leading-[1.6] text-[#3d3d3b]\" data-kid=\"1-2-2-4-1-2-3\" data-name=\"Michelle project description\">\n                            Built story-driven event triggers and atmospheric setups for\n                            <em data-kid=\"1-2-2-4-1-2-3-1\" data-name=\"Michelle project name emphasis\">\n                                Michelle\n                            </em>\n                            .\n                        </p>\n                        <a class=\"mt-3 inline-block text-[14px] font-medium underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-2-4-1-2-4\" data-name=\"play Michelle external link\" href=\"https://huge-games.itch.io/michelle\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            Play Michelle\n                            <span aria-hidden=\"true\" data-kid=\"1-2-2-4-1-2-4-1\" data-name=\"external link arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </article>\n                <article class=\"grid grid-cols-[112px_1fr] gap-5 border-b border-[#e2dfd5] py-6 sm:grid-cols-[148px_1fr] md:py-8\" data-kid=\"1-2-2-4-2\" data-name=\"Fruited to Return mini project card\">\n                    <img alt=\"Gameplay capture showing platforming in Fruited to Return.\" class=\"aspect-[1.2/1] w-full border border-[#eceae4] object-cover\" data-kid=\"1-2-2-4-2-1\" data-name=\"Fruited to Return gameplay thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/FruitedToReturn.gif\"/>\n                    <div class=\"self-center\" data-kid=\"1-2-2-4-2-2\" data-name=\"Fruited to Return details block\">\n                        <p class=\"text-[13px] text-[#5f5f5d]\" data-kid=\"1-2-2-4-2-2-1\" data-name=\"Fruited to Return project meta label\">\n                            Unity · C# · 48-hour jam\n                        </p>\n                        <h3 class=\"mt-1 text-[22px] font-semibold tracking-[-0.035em]\" data-kid=\"1-2-2-4-2-2-2\" data-name=\"Fruited to Return project title\">\n                            Precision platforming\n                        </h3>\n                        <p class=\"mt-2 text-[15px] leading-[1.6] text-[#3d3d3b]\" data-kid=\"1-2-2-4-2-2-3\" data-name=\"Fruited to Return project description\">\n                            Tuned physics and input responsiveness for a challenging 2D precision platformer.\n                        </p>\n                        <a class=\"mt-3 inline-block text-[14px] font-medium underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1c1c1c]\" data-kid=\"1-2-2-4-2-2-4\" data-name=\"play Fruited to Return external link\" href=\"https://huge-games.itch.io/fruited-to-return\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            Play Fruited to Return\n                            <span aria-hidden=\"true\" data-kid=\"1-2-2-4-2-2-4-1\" data-name=\"external link arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"projects-title\" class=\"border-t border-[#d9d6cb] py-20 md:py-24\" data-kid=\"1-2-3\" data-name=\"all projects section\" id=\"projects\">\n            <div class=\"grid gap-6 md:grid-cols-[0.7fr_1.3fr] md:items-end\" data-kid=\"1-2-3-1\" data-name=\"projects section header row\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"projects headline block\">\n                    <h2 class=\"text-[clamp(32px,4vw,48px)] font-semibold leading-[1.05] tracking-[-0.055em]\" data-kid=\"1-2-3-1-1-1\" data-name=\"all projects section headline\" id=\"projects-title\">\n                        All projects\n                    </h2>\n                    <p class=\"mt-3 max-w-[340px] text-[16px] leading-[1.6] text-[#5f5f5d]\" data-kid=\"1-2-3-1-1-2\" data-name=\"projects section description\">\n                        Ten games across Unity, Godot, client work, and jams.\n                    </p>\n                </div>\n                <div data-kid=\"1-2-3-1-2\" data-name=\"project filter and count block\">\n                    <div aria-label=\"Filter games by category\" class=\"flex flex-wrap gap-2\" data-kid=\"1-2-3-1-2-1\" data-name=\"project category filter group\" role=\"group\">\n                        <button aria-pressed=\"true\" class=\"project-filter min-h-11 border-b-2 border-[#1c1c1c] px-3 text-[14px] font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1c1c1c]\" data-dynamic=\"true\" data-filter=\"all\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"all projects filter button\" data-reason=\"visual state (border/text color/fonts) toggled by click handler to reflect active filter\" type=\"button\">\n                            All\n                        </button>\n                        <button aria-pressed=\"false\" class=\"project-filter min-h-11 border-b-2 border-transparent px-3 text-[14px] text-[#5f5f5d] hover:text-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1c1c1c]\" data-dynamic=\"true\" data-filter=\"unity\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"unity filter button\" data-reason=\"visual state (border/text color/fonts) toggled by click handler to reflect active filter\" type=\"button\">\n                            Unity\n                        </button>\n                        <button aria-pressed=\"false\" class=\"project-filter min-h-11 border-b-2 border-transparent px-3 text-[14px] text-[#5f5f5d] hover:text-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1c1c1c]\" data-dynamic=\"true\" data-filter=\"godot\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"godot filter button\" data-reason=\"visual state (border/text color/fonts) toggled by click handler to reflect active filter\" type=\"button\">\n                            Godot\n                        </button>\n                        <button aria-pressed=\"false\" class=\"project-filter min-h-11 border-b-2 border-transparent px-3 text-[14px] text-[#5f5f5d] hover:text-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1c1c1c]\" data-dynamic=\"true\" data-filter=\"jam\" data-kid=\"1-2-3-1-2-1-4\" data-name=\"game jams filter button\" data-reason=\"visual state (border/text color/fonts) toggled by click handler to reflect active filter\" type=\"button\">\n                            Game jams\n                        </button>\n                        <button aria-pressed=\"false\" class=\"project-filter min-h-11 border-b-2 border-transparent px-3 text-[14px] text-[#5f5f5d] hover:text-[#1c1c1c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1c1c1c]\" data-dynamic=\"true\" data-filter=\"professional\" data-kid=\"1-2-3-1-2-1-5\" data-name=\"professional filter button\" data-reason=\"visual state (border/text color/fonts) toggled by click handler to reflect active filter\" type=\"button\">\n                            Professional\n                        </button>\n                    </div>\n                    <p aria-live=\"polite\" class=\"mt-2 text-[13px] text-[#5f5f5d]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2\" data-name=\"project count status text\" data-reason=\"text replaced by filter script to reflect number of visible projects\" id=\"project-count\">\n                        Showing 10 projects\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-8 grid border-t border-[#d9d6cb] md:grid-cols-2 md:gap-x-12\" data-kid=\"1-2-3-2\" data-name=\"project rows grid container\">\n                <article class=\"project-row border-b border-[#e2dfd5] py-4\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1\" data-name=\"Fruited to Fight project row\" data-reason=\"visibility toggled (hidden attribute) by filter script\