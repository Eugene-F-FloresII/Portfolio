-kid=\"1-2-4-3-4-2-2\" data-name=\"project context description\">\n                            Interactive FMV campus tour · MMCM\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-4-3\" data-name=\"project engine tag\">\n                        Unity · C#\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-4-4\" data-name=\"project status tag\">\n                        Client project\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-4-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        See HuGe’s itch.io profile ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-5\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"unity\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-5-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/CatConnect.gif\"/>\n                    <div data-kid=\"1-2-4-3-5-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-5-2-1\" data-name=\"project name\">\n                            Cat Connect\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-5-2-2\" data-name=\"project context description\">\n                            Cozy café simulator · resource systems\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-5-3\" data-name=\"project engine tag\">\n                        Unity · C#\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-5-4\" data-name=\"project status tag\">\n                        Game project\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-5-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        See HuGe’s itch.io profile ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-6\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"godot,jam\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-6-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/Michelle.gif\"/>\n                    <div data-kid=\"1-2-4-3-6-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-6-2-1\" data-name=\"project name\">\n                            Michelle\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-6-2-2\" data-name=\"project context description\">\n                            2D psychological horror · Top 10 at Scream Secrets\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-6-3\" data-name=\"project engine tag\">\n                        Godot · GDScript\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-6-4\" data-name=\"project status tag\">\n                        Game jam\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-6-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/michelle\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Play on itch.io ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-7\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"godot,jam\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-7-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/PlatePals.gif\"/>\n                    <div data-kid=\"1-2-4-3-7-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-7-2-1\" data-name=\"project name\">\n                            Plate Pals\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-7-2-2\" data-name=\"project context description\">\n                            Pixel-art delivery simulator · Micro-Food Jam\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-7-3\" data-name=\"project engine tag\">\n                        Godot · GDScript\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-7-4\" data-name=\"project status tag\">\n                        Game jam\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-7-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/plate-pals\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Play on itch.io ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-8\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"unity,jam\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-8-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/FriggsGrillnThrill.gif\"/>\n                    <div data-kid=\"1-2-4-3-8-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-8-2-1\" data-name=\"project name\">\n                            Frigg’s Grill n Thrill\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-8-2-2\" data-name=\"project context description\">\n                            Cooking horror · Top 30, Scream Jam 2024\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-8-3\" data-name=\"project engine tag\">\n                        Unity · C#\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-8-4\" data-name=\"project status tag\">\n                        Game jam\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-8-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/friggs-grill-n-thrill\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Play on itch.io ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-9\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"unity\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-9-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/SherlockScience.png\"/>\n                    <div data-kid=\"1-2-4-3-9-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-9-2-1\" data-name=\"project name\">\n                            Sherlock Science\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-9-2-2\" data-name=\"project context description\">\n                            Educational point-and-click game\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-9-3\" data-name=\"project engine tag\">\n                        Unity · C#\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-9-4\" data-name=\"project status tag\">\n                        Educational\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-9-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        See HuGe’s itch.io profile ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-10\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"unity\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-10-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/Blacksmith.png\"/>\n                    <div data-kid=\"1-2-4-3-10-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-10-2-1\" data-name=\"project name\">\n                            Blacksmith Shop Simulation\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-10-2-2\" data-name=\"project context description\">\n                            Shop-management simulation\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-10-3\" data-name=\"project engine tag\">\n                        Unity · C#\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-10-4\" data-name=\"project status tag\">\n                        Game project\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-10-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        See HuGe’s itch.io profile ↗\n                    </a>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"about-title\" class=\"content-section\" data-kid=\"1-2-5\" data-name=\"about section\" id=\"about\">\n            <div class=\"about-grid\" data-kid=\"1-2-5-1\" data-name=\"about three-column grid\">\n                <img alt=\"Portrait of Eugene F. Flores II\" class=\"portrait\" data-kid=\"1-2-5-1-1\" data-name=\"developer portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/FormalPic.png\"/>\n                <div class=\"about-copy\" data-kid=\"1-2-5-1-2\" data-name=\"about text block\">\n                    <h2 data-kid=\"1-2-5-1-2-1\" data-name=\"about section title\" id=\"about-title\">\n                        About Eugene\n                    </h2>\n                    <p data-kid=\"1-2-5-1-2-2\" data-name=\"about self-introduction paragraph\">\n                        I’m a gameplay programmer who works across Unity and Godot. My background as an active gamer helps me think about how systems feel to play; I also bring a testing mindset to debugging and edge cases.\n                    </p>\n                    <p data-kid=\"1-2-5-1-2-3\" data-name=\"about experience summary paragraph\">\n                        I’ve built mechanics for multiplayer games, a campus-tour experience, and jam projects across platforming, simulation and horror.\n                    </p>\n                </div>\n                <div class=\"skills-note\" data-kid=\"1-2-5-1-3\" data-name=\"tools note block\">\n                    <h3 data-kid=\"1-2-5-1-3-1\" data-name=\"tools note title\">\n                        Tools used in my work\n                    </h3>\n                    <p data-kid=\"1-2-5-1-3-2\" data-name=\"tools list text\">\n                        C# · Unity · GDScript · Godot\n                        <br data-kid=\"1-2-5-1-3-2-1\"/>\n                        ScriptableObjects · FMV navigation\n                        <br data-kid=\"1-2-5-1-3-2-2\"/>\n                        Figma · Canva · Aseprite\n                        <br data-kid=\"1-2-5-1-3-2-3\"/>\n                        HTML · CSS\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"contact-title\" class=\"contact-band\" data-kid=\"1-2-6\" data-name=\"contact call-to-action band\" id=\"contact\">\n            <div data-kid=\"1-2-6-1\" data-name=\"contact heading block\">\n                <h2 data-kid=\"1-2-6-1-1\" data-name=\"contact heading text\" id=\"contact-title\">\n                    Let’s talk about the work.\n                </h2>\n                <p data-kid=\"1-2-6-1-2\" data-name=\"contact supporting text\">\n                    Reach out directly, or review my résumé and game pages.\n                </p>\n            </div>\n            <div class=\"contact-actions\" data-kid=\"1-2-6-2\" data-name=\"contact action buttons group\">\n                <a class=\"button-dark\" data-kid=\"1-2-6-2-1\" data-name=\"primary email contact button\" href=\"mailto:eFloresii@outlook.com\">\n                    <i aria-hidden=\"true\" class=\"icon-mail\" data-kid=\"1-2-6-2-1-1\" data-name=\"envelope icon\">\n                    </i>\n                    Email Eugene\n                </a>\n                <a class=\"button-link\" data-kid=\"1-2-6-2-2\" data-name=\"secondary résumé download button\" download=\"\" href=\"docs/Flores_Resume.pdf\">\n                    <i aria-hidden=\"true\" class=\"icon-download\" data-kid=\"1-2-6-2-2-1\" data-name=\"download icon\">\n                    </i>\n                    Résumé PDF\n                </a>\n            </div>\n        </section>\n        <footer class=\"footer\" data-kid=\"1-2-7\" data-name=\"site footer\">\n            <span data-kid=\"1-2-7-1\" data-name=\"copyright notice text\">\n                © 2026 Eugene F. Flores II · Game developer portfolio\n            </span>\n            <div class=\"footer-links\" data-kid=\"1-2-7-2\" data-name=\"footer link group\">\n                <a class=\"social-link\" data-kid=\"1-2-7-2-1\" data-name=\"GitHub social link\" href=\"https://github.com/Eugene-F-FloresII\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    <img alt=\"\" data-kid=\"1-2-7-2-1-1\" data-name=\"GitHub logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/GithubIcon.png\"/>\n                    GitHub\n                </a>\n                <a class=\"social-link\" data-kid=\"1-2-7-2-2\" data-name=\"LinkedIn social link\" href=\"https://www.linkedin.com/in/eugenefloresii/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    <img alt=\"\" data-kid=\"1-2-7-2-2-1\" data-name=\"LinkedIn logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/LinkedInIcon.png\"/>\n                    LinkedIn\n                </a>\n                <a class=\"social-link\" data-kid=\"1-2-7-2-3\" data-name=\"itch.io social link\" href=\"https://huge-games.itch.io/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    <img alt=\"\" data-kid=\"1-2-7-2-3-1\" data-name=\"itch.io logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/ItchioIcon.png\"/>\n                    itch.io\n                </a>\n                <a data-kid=\"1-2-7-2-4\" data-name=\"back to top link\" href=\"#top\">\n                    Back to top ↑\n                </a>\n            </div>\n        </footer>\n    </main>\n</div>\n<script>\n    const menu=document.querySelector('.menu-toggle');const nav=document.querySelector('.nav-links');menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));menu.setAttribute('aria-label',open?'Open navigation':'Close navigation');nav.classList.toggle('open',!open)});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Open navigation')}));\nconst filters=document.querySelectorAll('.filter-btn');const projects=document.querySelectorAll('.project-row');filters.forEach(btn=>btn.addEventListener('click',()=>{const f=btn.dataset.filter;filters.forEach(x=>x.setAttribute('aria-pressed',String(x===btn)));projects.forEach(row=>{row.hidden=f!=='all'&&!row.dataset.tags.split(',').includes(f)})}));\n</script>\n",
