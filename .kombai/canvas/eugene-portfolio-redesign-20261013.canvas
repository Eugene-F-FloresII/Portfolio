Professional\n                    </button>\n                </div>\n            </div>\n            <div aria-live=\"polite\" class=\"project-list\" data-kid=\"1-2-4-3\" data-name=\"projects list container\">\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-1\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"unity,professional\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-1-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/LangitLupa.png\"/>\n                    <div data-kid=\"1-2-4-3-1-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-1-2-1\" data-name=\"project name\">\n                            Langit Lupa: Office Wars\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-1-2-2\" data-name=\"project context description\">\n                            Multiplayer party game · NinetySix Studios\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-1-3\" data-name=\"project engine tag\">\n                        Unity · C#\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-1-4\" data-name=\"project status tag\">\n                        Released\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-1-5\" data-name=\"project external link\" href=\"https://store.steampowered.com/app/3428410/Langit_Lupa_Office_Wars/\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        View on Steam ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-2\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"unity,jam\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-2-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/Fruited%20to%20Fight%20GDD.png\"/>\n                    <div data-kid=\"1-2-4-3-2-2\" data-name=\"project title and context block\">\n                        <div class=\"project-name\" data-kid=\"1-2-4-3-2-2-1\" data-name=\"project name\">\n                            Fruited to Fight\n                        </div>\n                        <div class=\"project-context\" data-kid=\"1-2-4-3-2-2-2\" data-name=\"project context description\">\n                            2D roguelite · Pixel Forge Jam 2026\n                        </div>\n                    </div>\n                    <span class=\"project-engine\" data-kid=\"1-2-4-3-2-3\" data-name=\"project engine tag\">\n                        Unity · C#\n                    </span>\n                    <span class=\"project-type\" data-kid=\"1-2-4-3-2-4\" data-name=\"project status tag\">\n                        Awarded\n                    </span>\n                    <a class=\"project-link\" data-kid=\"1-2-4-3-2-5\" data-name=\"project external link\" href=\"https://huge-games.itch.io/fruited-to-fight\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Play on itch.io ↗\n                    </a>\n                </article>\n                <article class=\"project-row\" data-dynamic=\"true\" data-kid=\"1-2-4-3-3\" data-name=\"project row item\" data-reason=\"visibility controlled by hidden attribute toggled via filter script\" data-tags=\"unity,jam\">\n                    <img alt=\"\" class=\"project-thumb\" data-kid=\"1-2-4-3-3-1\" data-name=\"project thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/Assets/images/gifs/FruitedToReturn.gif\"/>